---
import Label from "../../components/Label.astro";
import Layout from "../../layouts/Layout.astro";

const formats = [
  { name: "CD", icon: "cd" },
  { name: "Digital", icon: "digital" },
  { name: "Blu-ray", icon: "blu-ray" },
  { name: "DVD", icon: "dvd" },
  { name: "Vinyl", icon: "vinyl" },
  { name: "Cassette", icon: "cassette" },
  { name: "Video Cassette", icon: "video-cassette" },
];

const categories = [
  { name: "Album", icon: "album" },
  { name: "Movie", icon: "movie" },
  { name: "Live Act", icon: "live-act" },
  { name: "Music Video", icon: "music-video" },
  { name: "TV Show", icon: "tv-show" },
  { name: "Playlist", icon: "playlist" },
];
---

<Layout title="Labels" numeral="10">
  <section class="demo">
    <div class="demo-container">
      <Label name="CD"  />
      <Label name="Digital" align="right" />
    </div>
  </section>
  <section>
    <h2>Alignment</h2>
    <p>
      <code>.label-align-left</code> or <code>.label-align-right</code> will align the label and the icon.
    </p>
    <div class="align-container">
        <Label name="Digital" align="left" />
        <Label name="Digital"  align="right" />
    </div>
   
</section>
    <section>
<h2>Formats</h2>
        <div>
            {formats.map((format) => <Label name={format.name} />)}
        </div>
    <h2>Categories</h2>
    <div>
      {categories.map((category) => <Label name={category.name} />)}
    </div>
  </section>
</Layout>

<style>
  section {
    display: grid;
    padding: 2rem;
    width: 100%;

    h2 {
      grid-column: 1 / -1;
      font-size: var(--fab-font-size-body);
      font-weight: 600;
      color: var(--fab-colour-text);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding-bottom: var(--fab-space-xs);
      border-bottom: 1px solid var(--fab-colour-border);
      margin-block-start: var(--fab-space-xl);
      margin-block-end: var(--fab-space-md);
    }

    p {
      grid-column: 1 / -1;
      color: var(--fab-colour-text-darker);
      font-size: var(--fab-font-size-small);
      margin-block-end: var(--fab-space-md);
    }

    &.demo {
      margin-block-start: var(--fab-space-xl);
      background:
        radial-gradient(
          circle at top left,
          color-mix(in oklab, var(--fab-colour-primary) 12%, transparent),
          transparent 40%
        ),
        var(--fab-background-checkerboard);

      .demo-container {
        display: inline-flex;
        justify-content: space-between;
        gap: var(--fab-space-2xl);
        width: fit-content;
        margin-inline: auto;
        background: linear-gradient(to bottom, var(--fab-colour-background) 80%, transparent);
        padding: var(--fab-space-sm);
        padding-block-end: var(--fab-space-lg);
        border-radius: var(--fab-radius-md) var(--fab-radius-md) 0 0;
        border-block-start: 1px solid var(--fab-colour-border);
      }
    }
    .align-container {
        display: flex;
        justify-content: space-between;
        gap: var(--fab-space-2xl);
        width: fit-content;
        margin-inline: auto;
      }
  }
</style>
