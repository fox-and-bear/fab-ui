---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

const { pathname } = Astro.url;

type NavItem = {
  name: string;
  href?: string;
  children?: NavItem[];
  icon?: string;
};

const foundations = [
  { name: "Colours", href: "/", icon: "colours" },
  { name: "Typography", href: "/fonts", icon: "typography" },
  { name: "Elevation", href: "/elevation", icon: "elevation" },
  { name: "Spacing", href: "/spacing", icon: "spacing" },
];

const components: NavItem[] = [
  { name: "Buttons", href: "/components/buttons", icon: "button" },
  { name: "Form Elements", href: "/components/form-elements", icon: "radio-button" },
  {
    name: "Forms",
    children: [
      { name: "Login Form", href: "/components/sign-in-form" },
      { name: "Registration Form", href: "/components/sign-up-form" },
    ],
    icon: "form",
  },
];
---

<div class="sidebar">
  <div class="sidebar-content">
    <header>
      <Logo />
    </header>
    <nav class="primary-navigation">
      <span class="nav-heading">Foundations</span>
      <ul class="nav-items">
        {
          foundations.map(({ name, href, icon }) => (
            <li class="nav-item">
              <a href={href} aria-label={name} class={pathname === href ? "active" : ""}>
                {icon && <Icon name={icon} size={16} />}
                {name}
              </a>
            </li>
          ))
        }
      </ul>

      <span class="nav-heading">Components</span>
      <ul class="nav-items">
        {
          components.map(({ name, href, children, icon }) => (
            <li class="nav-item">
              {href ? (
                <a href={href} aria-label={name} class={pathname.includes(href) ? "active" : ""}>
                  {icon && <Icon name={icon} size={16} />}
                  {name}
                </a>
              ) : (
                <span class="nested-menu" aria-expanded="false">
                  {icon && <Icon name={icon} size={16} />}
                  {name} <Icon name="chevron-right" size={16} />
                </span>
              )}

              {children && children.length > 0 && (
                <div class="transition-auto">
                  <ul class="nested-menu-items">
                    {children.map(({ name, href }) => (
                      <li class="nested-menu-item">
                        <a href={href} aria-label={name} class={pathname === href ? "active" : ""}>
                          {name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="user-info">
      <img src="/image/Avatar.svg" alt="User Avatar" />
      <span class="user-name">Kristian</span>
      <button class="icon ghost">
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          xmlns="http://www.w3.org/2000/svg">
          <path
            d="M11.167 12C12.0875 12 12.834 12.7465 12.834 13.667C12.834 14.5875 12.0875 15.334 11.167 15.334C10.2465 15.334 9.5 14.5875 9.5 13.667C9.5 12.7465 10.2465 12 11.167 12ZM11.167 13.334C10.9829 13.334 10.834 13.4829 10.834 13.667C10.834 13.8511 10.9829 14 11.167 14C11.3511 14 11.5 13.8511 11.5 13.667C11.5 13.4829 11.3511 13.334 11.167 13.334ZM11.167 7C12.0875 7 12.834 7.74652 12.834 8.66699C12.834 9.58747 12.0875 10.334 11.167 10.334C10.2465 10.334 9.5 9.58747 9.5 8.66699C9.5 7.74652 10.2465 7 11.167 7ZM11.167 8.33398C10.9829 8.33398 10.834 8.4829 10.834 8.66699C10.834 8.85109 10.9829 9 11.167 9C11.3511 9 11.5 8.85109 11.5 8.66699C11.5 8.4829 11.3511 8.33398 11.167 8.33398ZM11.167 2C12.0875 2 12.834 2.74652 12.834 3.66699C12.834 4.58747 12.0875 5.33398 11.167 5.33398C10.2465 5.33398 9.5 4.58747 9.5 3.66699C9.5 2.74652 10.2465 2 11.167 2ZM11.167 3.33398C10.9829 3.33398 10.834 3.4829 10.834 3.66699C10.834 3.85109 10.9829 4 11.167 4C11.3511 4 11.5 3.85109 11.5 3.66699C11.5 3.4829 11.3511 3.33398 11.167 3.33398Z"
            fill="#C8C8D0"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  const nestedMenuItems = document.querySelectorAll(".nested-menu");
  nestedMenuItems.forEach((item) => {
    item.addEventListener("click", () => {
      item.setAttribute(
        "aria-expanded",
        item.getAttribute("aria-expanded") === "true" ? "false" : "true",
      );
    });
  });
</script>
