---
import Layout from "../../layouts/Layout.astro";

const variants = [
  { name: "Primary", className: "", classLabel: "Default" },
  { name: "Secondary", className: "secondary", classLabel: ".secondary" },
  { name: "Danger", className: "danger", classLabel: ".danger" },
  { name: "Outline", className: "outline", classLabel: ".outline" },
  { name: "Ghost", className: "ghost", classLabel: ".ghost" },
];

const corners = [
  { name: "Top Left", className: "tl", previewClass: "tl" },
  { name: "Top Right", className: "tr", previewClass: "tr" },
  { name: "Bottom Left", className: "bl", previewClass: "bl secondary" },
  { name: "Bottom Right", className: "br", previewClass: "br outline" },
];

const groups = [
  { name: "Default", className: "", items: ["", "secondary", "danger"] },
  { name: "Top Right", className: "tr", items: ["", "secondary", "danger"] },
  { name: "Bottom Right", className: "br", items: ["", "secondary"] },
  { name: "Bottom Left", className: "bl", items: ["", "outline"] },
];
---

<Layout title="Buttons" numeral="05">
  <section id="button-variants" class="token-section button-section">
    <h2>Variants</h2>
    <p>
      Buttons are built from one base style and modifier classes. The default shape is slightly
      rounded with elevation, while variant classes control semantic intent.
    </p>

    <article class="token-card lead-card">
      <h6>Quick Preview</h6>
      <div class="preview-strip" role="group" aria-label="Button variant preview">
        <button>Primary</button>
        <button class="secondary">Secondary</button>
        <button class="danger">Danger</button>
        <button class="outline">Outline</button>
        <button class="ghost">Ghost</button>
      </div>
    </article>

    <table class="button-table">
      <thead>
        <tr>
          <th scope="col">Style</th>
          <th scope="col">Class</th>
          <th scope="col">Default</th>
          <th scope="col">Disabled</th>
        </tr>
      </thead>
      <tbody>
        {
          variants.map(({ name, className, classLabel }) => (
            <tr>
              <th scope="row">{name}</th>
              <td>
                <code>{classLabel}</code>
              </td>
              <td>
                <button class={className}>Button</button>
              </td>
              <td>
                <button class={className} disabled>
                  Button
                </button>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section id="button-icons" class="token-section button-section">
    <h2>Icons</h2>
    <p>
      Use the <code>.icon</code> class for icon-only actions. Icons inherit <code>currentColor</code
      >
      and follow each variant state automatically.
    </p>

    <div class="demo-grid">
      <article class="token-card demo-card">
        <h6>Icon Only</h6>
        <div class="demo-row">
          <button class="icon" aria-label="Add item">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 5v14M5 12h14"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
          </button>
          <button class="icon" aria-label="Add item" disabled>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 5v14M5 12h14"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </article>

      <article class="token-card demo-card">
        <h6>Icon Left</h6>
        <div class="demo-row">
          <button>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 5v14M5 12h14"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
            Create
          </button>
          <button disabled>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 5v14M5 12h14"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
            Create
          </button>
        </div>
      </article>

      <article class="token-card demo-card">
        <h6>Icon Right</h6>
        <div class="demo-row">
          <button class="secondary">
            Continue
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M5 12h14M13 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <button class="secondary" disabled>
            Continue
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M5 12h14M13 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </article>
    </div>
  </section>

  <section id="button-corners" class="token-section button-section">
    <h2>Corners and Groups</h2>
    <p>
      Corner modifiers (<code>.tl</code>, <code>.tr</code>, <code>.bl</code>, <code>.br</code>) also
      apply to
      <code>.button-group</code>, so grouped controls can match the same geometric direction.
    </p>

    <div class="demo-grid split-grid">
      <article class="token-card demo-card">
        <h6>Corner Modifiers</h6>
        <table class="button-table compact">
          <thead>
            <tr>
              <th scope="col">Style</th>
              <th scope="col">Class</th>
              <th scope="col">Preview</th>
            </tr>
          </thead>
          <tbody>
            {
              corners.map(({ name, className, previewClass }) => (
                <tr>
                  <th scope="row">{name}</th>
                  <td>
                    <code>.{className}</code>
                  </td>
                  <td>
                    <button class={previewClass}>Button</button>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </article>

      <article class="token-card demo-card">
        <h6>Button Groups</h6>
        <div class="group-stack">
          {
            groups.map(({ name, className, items }) => (
              <div class="group-row">
                <span>{name}</span>
                <div class={`button-group ${className}`.trim()}>
                  {items.map((itemClass, idx) => (
                    <button class={itemClass}>
                      {idx === 0 ? "Primary" : idx === 1 ? "Secondary" : "Danger"}
                    </button>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </article>
    </div>
  </section>
</Layout>

<style>
  .button-section {
    grid-template-columns: repeat(auto-fill, minmax(min(24rem, 100%), 1fr));
    gap: var(--fab-space-sm);
    padding-block: var(--fab-space-xl);
  }

  .lead-card {
    grid-column: 1 / -1;
    overflow: clip;
    background:
      radial-gradient(
        circle at top left,
        color-mix(in oklab, var(--fab-colour-primary) 12%, transparent),
        transparent 40%
      ),
      var(--fab-token-checkerboard);
  }

  .preview-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--fab-space-xs);
    align-items: center;
    justify-content: center;
    padding-block: var(--fab-space-md);
    border-radius: var(--fab-radius-sm);
    border: 1px solid var(--fab-colour-border);
    box-shadow: var(--fab-elevation-02);
    background:
      linear-gradient(
        155deg,
        color-mix(in oklab, var(--fab-colour-info) 12%, transparent),
        transparent 50%
      ),
      var(--fab-colour-background);
  }

  .demo-grid {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: var(--fab-space-sm);
  }

  .demo-card {
    gap: var(--fab-space-xs);
  }

  .demo-row {
    min-height: 6rem;
    display: flex;
    gap: var(--fab-space-2xs);
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    padding: var(--fab-space-sm);
    border: 1px solid var(--fab-colour-border);
    border-radius: var(--fab-radius-sm);
    background:
      radial-gradient(
        circle at top right,
        color-mix(in oklab, var(--fab-colour-primary) 16%, transparent),
        transparent 40%
      ),
      var(--fab-token-checkerboard);
  }

  .demo-row svg {
    width: var(--fab-font-size-body);
    height: var(--fab-font-size-body);
  }

  .button-table {
    grid-column: 1 / -1;
    width: 100%;
    max-width: unset;
    margin: 0;
  }

  .button-table code {
    white-space: nowrap;
  }

  .compact {
    box-shadow: none;
    border-top: 0;
    border-bottom: 0;
  }

  .split-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(26rem, 100%), 1fr));
  }

  .group-stack {
    display: grid;
    gap: var(--fab-space-sm);
  }

  .group-row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    align-items: center;
    gap: var(--fab-space-sm);
  }

  .group-row > span {
    font-size: var(--fab-font-size-small);
    color: var(--fab-colour-text-darker);
  }

  @media (max-width: 48rem) {
    .button-section {
      padding-block: var(--fab-space-lg);
    }

    .group-row {
      grid-template-columns: 1fr;
    }
  }
</style>
