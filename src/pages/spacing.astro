---
import Layout from "../layouts/Layout.astro";

const spacings = [
  { name: "4xs", variable: "fab-space-4xs", range: "2px - 2px" },
  { name: "3xs", variable: "fab-space-3xs", range: "3px - 4px" },
  { name: "2xs", variable: "fab-space-2xs", range: "6px - 8px" },
  { name: "xs", variable: "fab-space-xs", range: "9px - 12px" },
  { name: "sm", variable: "fab-space-sm", range: "12px - 16px" },
  { name: "md", variable: "fab-space-md", range: "18px - 24px" },
  { name: "lg", variable: "fab-space-lg", range: "24px - 32px" },
  { name: "xl", variable: "fab-space-xl", range: "36px - 48px" },
  { name: "2xl", variable: "fab-space-2xl", range: "48px - 64px" },
];
const pairedSpacings = [
  { name: "4xs → 3xs", variable: "fab-space-4xs-p", range: "2px - 4px" },
  { name: "3xs → 2xs", variable: "fab-space-3xs-p", range: "3px - 8px" },
  { name: "2xs → xs", variable: "fab-space-2xs-p", range: "6px - 12px" },
  { name: "xs → sm", variable: "fab-space-xs-p", range: "9px - 16px" },
  { name: "sm → md", variable: "fab-space-sm-p", range: "12px - 24px" },
  { name: "md → lg", variable: "fab-space-md-p", range: "18px - 32px" },
  { name: "lg → xl", variable: "fab-space-lg-p", range: "24px - 48px" },
  { name: "xl → 2xl", variable: "fab-space-xl-p", range: "36px - 64px" },
  { name: "2xl → 3xl", variable: "fab-space-2xl-p", range: "48px - 96px" },
];

const radii = [
  { name: "none", variable: "fab-radius-none", range: "0px" },
  { name: "xs", variable: "fab-radius-xs", range: "3px - 4px" },
  { name: "sm", variable: "fab-radius-sm", range: "6px - 8px" },
  { name: "md", variable: "fab-radius-md", range: "18px - 24px" },
  { name: "lg", variable: "fab-radius-lg", range: "24px - 32px" },
  { name: "xl", variable: "fab-radius-xl", range: "36px - 48px" },
  { name: "full", variable: "fab-radius-full", range: "9999px" },
];
---

<Layout title="Spacing" numeral="04">
  <section id="spacing-section" class="token-section">
    <h2>Spacing Tokens</h2>
    <p>
      All spacings are clamped based on screen size, only applicable to smaller screen sizes &lt;
      1240px.
    </p>
    {
      spacings.map(({ name, variable, range }) => (
        <div class="token-card" data-token={variable} data-type="spacing">
          <h6>{name}</h6>
          <div class="spacing-display">
            <div class="padding-block" style={`inline-size: var(--${variable});`} />
            <div class="padding-content" />
            <div class="padding-block" style={`inline-size: var(--${variable});`} />
          </div>
          <code>--{variable}</code>
          <span class="token-range">
            {range}
            <span class="token-current">—</span>
          </span>
        </div>
      ))
    }
  </section>

  <section id="spacing-paired-section" class="token-section">
    <h2>Paired Spacing Tokens</h2>
    <p>
      Paired spacings are used to create a greater variation in spacing, so should be used
      sparingly.
    </p>
    {
      pairedSpacings.map(({ name, variable, range }) => (
        <div class="token-card" data-token={variable} data-type="spacing">
          <h6>{name}</h6>
          <div class="spacing-display">
            <div class="padding-block" style={`inline-size: var(--${variable});`} />
            <div class="padding-content" />
            <div class="padding-block" style={`inline-size: var(--${variable});`} />
          </div>
          <code>--{variable}</code>
          <span class="token-range">
            {range}
            <span class="token-current">—</span>
          </span>
        </div>
      ))
    }
  </section>

  <section id="radii-section" class="token-section">
    <h2>Radius Tokens</h2>
    {
      radii.map(({ name, variable, range }) => (
        <div class="token-card" data-token={variable} data-type="radii">
          <h6>{name}</h6>
          <div class="radii-swatch" style={`border-radius: var(--${variable});`} />
          <code>--{variable}</code>
          <span class="token-range">
            {range}
            <span class="token-current">—</span>
          </span>
        </div>
      ))
    }
  </section>
</Layout>

<style>
  main {
  }

  #spacing-section,
  #spacing-paired-section,
  #radii-section {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(13rem, 100%), 1fr));
    gap: var(--fab-space-md);
    margin-bottom: var(--fab-space-2xl);
    padding-inline: var(--fab-space-lg);
  }

  #spacing-section {
    padding-block-start: var(--fab-space-xl);
  }

  section > h2 {
    grid-column: 1 / -1;
    font-size: var(--fab-font-size-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-bottom: var(--fab-space-xs);
    border-bottom: 1px solid var(--fab-colour-border);
  }

  section > p {
    grid-column: 1 / -1;
    color: var(--fab-colour-text-darker);
    font-size: var(--fab-font-size-small);
  }

  :global(.token-card) {
    display: flex;
    flex-direction: column;
    gap: var(--fab-space-2xs);
    padding: var(--fab-space-sm);
    background: var(--fab-colour-background);
    border: 1px solid var(--fab-colour-border);
    border-radius: var(--fab-radius-sm);
    box-shadow: var(--fab-elevation-01, 0 1px 3px rgba(0, 0, 0, 0.04));
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  :global(.token-card h6) {
    font-size: var(--fab-font-size-body);
    font-weight: 700;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  :global(.token-card code) {
    font-size: var(--fab-font-size-caption);
    color: var(--fab-colour-primary);
    word-break: break-all;
    background: var(--fab-colour-background-lighter);
    padding: var(--fab-space-4xs) var(--fab-space-3xs);
    border-radius: var(--fab-radius-xs);
    align-self: flex-start;
  }

  :global(.token-range) {
    font-size: var(--fab-font-size-caption);
    color: var(--fab-colour-text-disabled);
    font-variant-numeric: tabular-nums;
  }

  /* Paired indicator (if you add data-pair later) */
  /*
  :global(.token-card[data-pair="true"] h6::after) {
    content: "pair";
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-left: var(--fab-space-3xs);
    padding: 2px var(--fab-space-3xs);
    padding-block-end: 0;
    background: var(--fab-colour-primary-darker);
    color: var(--fab-colour-primary-on);
    border-radius: var(--fab-radius-xs);
    display: inline-grid;
    place-content: center;
  }
  */

  :global(.spacing-display) {
    position: relative;
    min-height: 3.5rem;
    display: flex;
    align-items: stretch;
    background: repeating-linear-gradient(
      45deg,
      var(--fab-colour-background) 0,
      var(--fab-colour-background) 6px,
      var(--fab-colour-background-darker) 6px,
      var(--fab-colour-background-darker) 12px
    );
    border: 1px solid var(--fab-colour-border);
    border-radius: var(--fab-radius-xs);
    overflow: hidden;
  }

  :global(.spacing-display .padding-block) {
    background: var(--fab-colour-primary);
    opacity: 0.15;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  :global(.spacing-display .padding-content) {
    flex: 1;
    border-inline: 2px solid var(--fab-colour-primary);
    opacity: 0.75;
  }

  :global(.token-card:hover .spacing-display .padding-block) {
    opacity: 0.5;
  }

  :global(.radii-swatch) {
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--fab-colour-border);
    background: repeating-linear-gradient(
      45deg,
      var(--fab-colour-background) 0,
      var(--fab-colour-background) 6px,
      var(--fab-colour-background-darker) 6px,
      var(--fab-colour-background-darker) 12px
    );
    box-shadow: var(--fab-elevation-01, 0 1px 3px rgba(0, 0, 0, 0.04));
    position: relative;
  }

  :global(.radii-swatch::after) {
    content: "";
    position: absolute;
    inset: var(--fab-space-4xs);
    border: 2px dashed var(--fab-colour-primary);
    border-radius: inherit;
    opacity: 0.25;
    pointer-events: none;
  }
</style>

<script>
  import { initCopyToken } from "../scripts/copyToken";
  import { initSpacingUpdates } from "../scripts/spacing";

  // Initialize both on mount
  document.addEventListener("DOMContentLoaded", () => {
    initCopyToken(); // Handles <code> element clicks
    initSpacingUpdates(); // Handles live value polling
  });
</script>
