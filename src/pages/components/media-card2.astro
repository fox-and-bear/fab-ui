---
import Layout from "../../layouts/Layout.astro";
import MediaCard from "../../components/MediaCard2.astro";


const titles = [
  {
    title: "Froot",
    artist: "Marina",
    artistLink: "#",
    image: "/media/images/froot.png",
    href: "/components/media-card",
    format: "CD",
    categories: ["Album"],
  },
  {
    title: "Amplified Heart (2026) Deluxe Edition",
    artist: "Everything But the Girl",
    artistLink: "#",
    image: "/media/images/ebtg.jpg",
    href: "/components/media-card",
    format: "CD",
    categories: ["Album"],
    layout: "top",
  },
  {
    title: "Season 25",
    artist: "Doctor Who",
    artistLink: "#",
    image: "/media/images/doctorwho.jpg",
    href: "/components/media-card",
    format: "Blu-Ray",
    categories: ["TV Series"],
  },
  {
    title: "Princess of Power",
    artist: "Marina",
    artistLink: "#",
    image: "/media/images/princessofpower.jpg",
    href: "/components/media-card",
    format: "Vinyl",
    categories: ["Album"],
    layout: "bottom",
  },

  {
    title: "Season 25",
    artist: "Doctor Who",
    artistLink: "#",
    image: "/media/images/doctorwho.jpg",
    href: "/components/media-card",
    format: "Blu-Ray",
    categories: ["TV Series"],
    layout: "cover",
  },
  {
    title: "Froot",
    artist: "Marina",
    artistLink: "#",
    image: "/media/images/froot.png",
    href: "/components/media-card",
    format: "CD",
    categories: ["Album"],
  },
  {
    title: "Amplified Heart (2026) Deluxe Edition",
    artist: "Everything But the Girl",
    artistLink: "#",
    image: "/media/images/ebtg.jpg",
    href: "/components/media-card",
    format: "CD",
    categories: ["Album"],
  },

  {
    title: "Princess of Power",
    artist: "Marina",
    artistLink: "#",
    image: "/media/images/princessofpower.jpg",
    href: "/components/media-card",
    format: "Vinyl",
    categories: ["Album"],
  },
];
---

<Layout title="Media Card" numeral="11">
  <div class="card-deck">
    {titles.map((props) => <MediaCard {...props} />)}
  </div>
  <section></section>

  <style>
    section {
      display: grid;
      gap: var(--fab-space-xl);
      padding: 2rem;

      h2 {
        grid-column: 1 / -1;
        font-size: var(--fab-font-size-body);
        font-weight: 600;
        color: var(--fab-colour-text);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding-bottom: var(--fab-space-xs);
        border-bottom: 1px solid var(--fab-colour-border);
        margin-block-start: var(--fab-space-xl);
        margin-block-end: var(--fab-space-md);
      }

      p {
        grid-column: 1 / -1;
        color: var(--fab-colour-text-darker);
        font-size: var(--fab-font-size-small);
      }

      &.demo {
        margin-block-start: var(--fab-space-xl);
        background:
          radial-gradient(
            circle at top left,
            color-mix(in oklab, var(--fab-colour-primary) 12%, transparent),
            transparent 40%
          ),
          var(--fab-background-checkerboard);

        .demo-container {
          display: flex;
          justify-content: space-between;
          gap: var(--fab-space-2xl);
          background: linear-gradient(to bottom, var(--fab-colour-background) 80%, transparent);
          padding: var(--fab-space-sm);
          padding-block-end: var(--fab-space-lg);
          border-radius: var(--fab-radius-md) var(--fab-radius-md) 0 0;
          border-block-start: 1px solid var(--fab-colour-border);
        }
      }
    }
    .card-deck {
      display: grid;
      justify-items: center;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--fab-space-md);
      background: var(--fab-colour-background);
      padding: var(--fab-space-md);
    }
  </style>
</Layout>
