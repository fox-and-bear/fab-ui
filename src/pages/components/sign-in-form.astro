---
import Layout from "../../layouts/Layout.astro";
import Logo from "../../components/Logo.astro";
---

<Layout title="Sign In Form" numeral="06">
  <button
    class="dialog-button"
    aria-label="Open sign in form"
    type="button"
    command="show-modal"
    commandfor="fab-dialog">
    Open Dialog
  </button>

  <div class="card" role="group" aria-label="Sign in form preview">
    <header><Logo /></header>
    <form class="sign-in-form">
      <div class="input-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required />
      </div>
      <div class="input-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required />
      </div>
      <button type="submit">Sign In</button>
    </form>
    <a href="#" class="forgot-pass">Forgot your password?</a>
    <footer>
      <span>Not yet a member? <a href="#">Create an account</a></span>
    </footer>
  </div>

  <dialog class="fab-dialog" id="fab-dialog" aria-label="Sign in form" closedby="any">
    <div class="card" role="group" aria-label="Sign in form preview">
      <header><Logo /></header>
      <form class="sign-in-form">
        <div class="input-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="input-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required />
        </div>
        <button type="submit">Sign In</button>
      </form>
      <a href="#" class="forgot-pass">Forgot your password?</a>
      <footer>
        <span>Not yet a member? <a href="#">Create an account</a></span>
      </footer>
    </div>
  </dialog>
</Layout>

<style>
  .card {
    min-width: 20rem;
    margin: 3rem auto;
  }

  .forgot-pass {
    font-size: var(--fab-font-size-small);
    align-self: start;
  }

  form {
    display: grid;
    gap: var(--fab-space-sm);

    button {
      margin-block-start: var(--fab-space-sm);
      margin-inline: auto;
    }
    input {
      width: 100%;
    }
  }

  /* Open state of the dialog   */
  dialog[open] {
    opacity: 1;
    transform: translateY(0);
  }

  /* Closed state of the dialog   */
  dialog {
    opacity: 0;
    transform: translateY(10%);
    transition:
      opacity 0.27s ease-out,
      transform 0.27s ease-in-out,
      overlay 0.27s ease-out allow-discrete,
      display 0.27s ease-out allow-discrete;
    /* Equivalent to
  transition: all 0.7s allow-discrete; */
    top: 40%;
    left: 50%;
    translate: -50% -50%;
    border: none;
    border-radius: var(--fab-radius-sm);
    box-shadow: var(--fab-elevation-06);

    .card {
      margin: 0;
    }
  }

  /* Before open state  */
  @starting-style {
    dialog[open] {
      opacity: 0;
      transform: translateY(-5%);
    }
  }

  dialog[open]::backdrop {
    backdrop-filter: blur(3px);
  }

  /* Transition the :backdrop when the dialog modal is promoted to the top layer */
  dialog::backdrop {
    background-color: transparent;
    backdrop-filter: blur(0px);
    transition: all 0.7s allow-discrete;
  }



  @starting-style {
    dialog[open]::backdrop {
      background-color: transparent;
      backdrop-filter: blur(0px);
    }
  }
</style>
