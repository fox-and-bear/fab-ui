---
import Logo from "../Logo.astro";
---

<div class="card" role="group" aria-label="Sign up form preview">
  <Logo layout="stacked" />
  <h1>Register</h1>
  <!-- NB to submit form using external button, form property on button must equal the form id -->
  <form class="sign-up-form" id="sign-up-form">
    <div class="input-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required placeholder="example@domain.com" />
    </div>
    <div class="input-group">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" required placeholder="Frivolous_Fox" />
    </div>
    <div class="input-group">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required />
    </div>
    <div class="input-group">
      <label for="confirm-password">Confirm Password</label>
      <input type="password" id="confirm-password" name="confirm-password" required />
    </div>
  </form>
  <!-- NB to submit form using external button, form property on button must equal the form id -->
  <button class="tl" type="submit" form="sign-up-form">Sign Up</button>
  <span class="link-to-other-form">Already a member? <a href="#">Sign In</a></span>
</div>

<style>
  .card {
    min-width: 430px;
    margin: 3rem auto;

    padding: var(--fab-space-xl) var(--fab-space-2xl);
    display: grid;
    justify-items: center;
    gap: var(--fab-space-lg);

    h1 {
      font-size: var(--fab-font-size-h5);
      color: inherit;
    }
  }

  .link-to-other-form,
  .forgot-pass {
    font-size: var(--fab-font-size-caption);
    font-weight: var(--fab-font-weight-light);
    align-self: start;
  }

  form {
    display: grid;
    gap: var(--fab-space-md);
    width: 100%;
    padding-block: var(--fab-space-lg);
    border-block: 1px solid var(--fab-colour-primary);

    input {
      width: 100%;
    }
  }
</style>
