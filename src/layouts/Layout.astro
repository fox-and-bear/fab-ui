---
import Sidebar from "../components/Sidebar.astro";
import "../styles/index.css"

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.6.2/dist/js/tom-select.complete.min.js"
    ></script>
    <script src="/src/scripts/copyToken.js" defer></script>
    <!-- <link rel="stylesheet" href="/src/styles/index.css" /> -->
    <title>{Astro.props.title}</title>
    <script>
      import "../../components/fab-select/fab-select.js";
    </script>
  </head>
  <body class="layout-sidebar">
    <header>
      <h1 class="numbered-heading">{Astro.props.numeral} <span>{Astro.props.title}</span></h1>
    </header>
    <Sidebar />
    <main>
      <slot />
    </main>
  </body>
</html>
