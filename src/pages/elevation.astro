---
import Layout from "../layouts/Layout.astro";

const elevations = [
  {
    name: "01 Inset",
    variable: "fab-elevation-01-inset",
    use: ["Call-outs"],
  },
  {
    name: "00",
    variable: "fab-elevation-00",
    use: ["Transitions"],
  },
  {
    name: "01",
    variable: "fab-elevation-01",
    use: ["Cards", "Pressed Buttons"],
  },
  {
    name: "02",
    variable: "fab-elevation-02",
    use: ["Buttons", "Notification Badges"],
  },
  {
    name: "03",
    variable: "fab-elevation-03",
    use: ["Navbar", "Menu Bars"],
  },
  {
    name: "04",
    variable: "fab-elevation-04",
    use: ["Card Raised", "Button Raised"],
  },
  {
    name: "05",
    variable: "fab-elevation-05",
    use: ["Popovers", "Pickers", "Tooltips"],
  },
  {
    name: "06",
    variable: "fab-elevation-06",
    use: ["Modals", "Dialogs"],
  },
];
---

<Layout title="Elevation" numeral="03">
  <section id="elevation-section" class="token-section">
    <h2>Box Shadow Tokens</h2>
    {
      elevations.map(({ name, variable, use }) => (
        <div class="token-card" data-token={variable} data-type="elevation">
          <h6 data-elevation={name}>{name}</h6>
          <div class="shadow-swatch">
            <div class="shadow-box" style={`box-shadow: var(--${variable});`} />
          </div>
          <code>--{variable}</code>
          <ul>
            {use.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <span class="token-range">
            Shadow layer
            <span class="token-current">—</span>
          </span>
        </div>
      ))
    }
  </section>
</Layout>

<style>
  #elevation-section {
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: var(--fab-space-md);
    margin-bottom: var(--fab-space-2xl);

    padding: var(--fab-space-xl) var(--fab-space-lg);
  }

  /* ── Section headers ── */
  section > h2 {
    grid-column: 1 / -1;
    font-size: var(--fab-font-size-body);
    font-weight: 600;
    color: var(--fab-colour-text);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-bottom: var(--fab-space-xs);
    border-bottom: 1px solid var(--fab-colour-border);
    margin-bottom: var(--fab-space-md);
  }

  .token-card {
    display: flex;
    flex-direction: column;
    gap: var(--fab-space-2xs);
    padding: var(--fab-space-sm);
    background: var(--fab-colour-background);
    border: 1px solid var(--fab-colour-border);
    border-radius: var(--fab-radius-sm);
    box-shadow: var(--fab-elevation-01, 0 1px 3px rgba(0, 0, 0, 0.04));
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
    position: relative;
  }

  /* .token-card:hover {
      box-shadow: var(--fab-elevation-03, 0 4px 16px rgba(0,0,0,.08));
      transform: translateY(-2px);
    } */

  .token-card h6 {
    font-size: var(--fab-font-size-body);
    font-weight: 700;
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--fab-space-3xs);
    justify-content: flex-start;
    gap: var(--space-3xs);
  }

  .token-card code {
    font-size: var(--fab-font-size-caption);
    color: var(--fab-colour-primary);
    word-break: break-all;
    background: var(--fab-colour-background-lighter, #f4f4f8);
    padding: var(--fab-space-4xs) var(--fab-space-3xs);
    border-radius: var(--fab-radius-xs);
    align-self: flex-start;
    display: inline-block;
  }

  .token-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--fab-font-size-caption);
    color: var(--fab-colour-text-darker);
  }

  .token-card ul li {
    padding-left: var(--fab-space-xs);
    border-left: 1px solid var(--fab-colour-primary);
  }

  /* ── Shadow swatch ── */
  .shadow-swatch {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--fab-background-checkerboard);
    border-radius: var(--fab-radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  @property --pulse-value {
    syntax: "<number>";
    inherits: false;
    initial-value: 0;
  }

  @property --pulse-intensity {
    syntax: "<number>";
    inherits: false;
    initial-value: 0;
  }

  .shadow-box {
    --pulse-value: 0;
    --pulse-intensity: 0;
    --pulse-size-increase: 0.2; /* e.g. 0.1 = 10% increase in size, 0.2 = 20% increase in size */
    width: 60%;
    height: 60%;
    background: var(--fab-colour-background-lighter);
    border-radius: var(--fab-radius-xs);

    transform: scale(
      calc(1 + var(--pulse-value) * var(--pulse-size-increase) * var(--pulse-intensity))
    );
    transition:
      box-shadow 0.2s ease,
      --pulse-intensity 0.5s ease-in-out;
    animation: pulse 1.5s ease-in-out infinite;

    .token-card:hover & {
      --pulse-intensity: 1;
    }
  }

  @keyframes pulse {
    0%,
    100% {
      --pulse-value: 0;
    }
    50% {
      --pulse-value: 1;
    }
  }
</style>

<script>
  import { initElevationUpdates } from "../scripts/elevations";
  import { initCopyToken } from "../scripts/copyToken";

  // Run both initializers on mount
  document.addEventListener("DOMContentLoaded", () => {
    initCopyToken(); // Adds click listeners to <code> elements
    initElevationUpdates(); // Starts live shadow value polling
  });
</script>
